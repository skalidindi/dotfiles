#!/usr/bin/env bash
set -euo pipefail

copy_or_merge_json() {
  local template="$1"
  local target="$2"
  local label="$3"
  local tmp
  local template_canonical
  local target_canonical

  [ -f "$template" ] || return 0
  mkdir -p "$(dirname "$target")"

  if [ ! -e "$target" ]; then
    cp "$template" "$target"
    printf 'installed %s\n' "$label"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf 'kept %s; jq unavailable for merge\n' "$label" >&2
    return 0
  fi

  tmp="$(mktemp "${TMPDIR:-/tmp}/agent-assets.XXXXXXXX")"
  if ! jq -s '
    def unique_in_order:
      reduce .[] as $item ([]; if index($item) then . else . + [$item] end);

    .[0] as $base
    | .[1] as $live
    | ($base * $live)
    | .packages = (
        (($base.packages // []) + ($live.packages // []))
        | unique_in_order
      )
  ' "$template" "$target" >"$tmp"; then
    rm -f "$tmp"
    printf 'kept %s; merge failed\n' "$label" >&2
    return 1
  fi

  template_canonical="$(jq -S -c . "$tmp" 2>/dev/null || true)"
  target_canonical="$(jq -S -c . "$target" 2>/dev/null || true)"

  if [ -n "$template_canonical" ] && [ "$template_canonical" = "$target_canonical" ]; then
    rm -f "$tmp"
    printf 'ok %s\n' "$label"
    return 0
  fi

  mv "$tmp" "$target"
  printf 'merged %s\n' "$label"
}

merge_json_live_wins() {
  local template="$1"
  local target="$2"
  local label="$3"
  local tmp
  local merged_canonical
  local target_canonical

  [ -f "$template" ] || return 0
  mkdir -p "$(dirname "$target")"

  if [ ! -e "$target" ]; then
    cp "$template" "$target"
    printf 'installed %s\n' "$label"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf 'kept %s; jq unavailable for merge\n' "$label" >&2
    return 0
  fi

  tmp="$(mktemp "${TMPDIR:-/tmp}/agent-assets.XXXXXXXX")"
  if ! jq -s '.[0] * .[1]' "$template" "$target" >"$tmp"; then
    rm -f "$tmp"
    printf 'kept %s; merge failed\n' "$label" >&2
    return 1
  fi

  merged_canonical="$(jq -S -c . "$tmp" 2>/dev/null || true)"
  target_canonical="$(jq -S -c . "$target" 2>/dev/null || true)"

  if [ -n "$merged_canonical" ] && [ "$merged_canonical" = "$target_canonical" ]; then
    rm -f "$tmp"
    printf 'ok %s\n' "$label"
    return 0
  fi

  mv "$tmp" "$target"
  printf 'merged %s\n' "$label"
}

merge_json_with_hook_arrays() {
  local template="$1"
  local target="$2"
  local label="$3"
  local tmp
  local merged_canonical
  local target_canonical

  [ -f "$template" ] || return 0
  mkdir -p "$(dirname "$target")"

  if [ ! -e "$target" ]; then
    cp "$template" "$target"
    printf 'installed %s\n' "$label"
    return 0
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf 'kept %s; jq unavailable for merge\n' "$label" >&2
    return 0
  fi

  tmp="$(mktemp "${TMPDIR:-/tmp}/agent-assets.XXXXXXXX")"
  if ! jq -s '
    def hook_union($base; $live):
      (($base // []) + ($live // []))
      | unique_by(tostring);

    .[0] as $base
    | .[1] as $live
    | ($base * $live)
    | .hooks = (
        (($base.hooks // {}) * ($live.hooks // {})) as $merged_hooks
        | reduce ((($base.hooks // {}) + ($live.hooks // {})) | keys[]) as $event (
            $merged_hooks;
            .[$event] = hook_union($base.hooks[$event]; $live.hooks[$event])
          )
      )
  ' "$template" "$target" >"$tmp"; then
    rm -f "$tmp"
    printf 'kept %s; merge failed\n' "$label" >&2
    return 1
  fi

  merged_canonical="$(jq -S -c . "$tmp" 2>/dev/null || true)"
  target_canonical="$(jq -S -c . "$target" 2>/dev/null || true)"

  if [ -n "$merged_canonical" ] && [ "$merged_canonical" = "$target_canonical" ]; then
    rm -f "$tmp"
    printf 'ok %s\n' "$label"
    return 0
  fi

  mv "$tmp" "$target"
  printf 'merged %s\n' "$label"
}

copy_if_changed() {
  local source="$1"
  local target="$2"
  local label="$3"

  [ -f "$source" ] || return 0
  mkdir -p "$(dirname "$target")"

  if [ -f "$target" ] && cmp -s "$source" "$target"; then
    printf 'ok %s\n' "$label"
    return 0
  fi

  cp "$source" "$target"
  printf 'synced %s\n' "$label"
}

copy_if_missing() {
  local source="$1"
  local target="$2"
  local label="$3"

  [ -f "$source" ] || return 0
  mkdir -p "$(dirname "$target")"

  if [ -e "$target" ]; then
    printf 'ok %s\n' "$label"
    return 0
  fi

  cp "$source" "$target"
  printf 'installed %s\n' "$label"
}

usage() {
  cat <<'EOF'
Usage:
  install-agent-assets

Options:
  -h, --help Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'install-agent-assets: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

copy_if_changed \
  "$HOME/.agents/prompts/base.md" \
  "$HOME/.claude/CLAUDE.md" \
  "Claude base prompt"

copy_if_changed \
  "$HOME/.agents/prompts/base.md" \
  "$HOME/.codex/AGENTS.md" \
  "Codex base prompt"

if [ -d "$HOME/.agents" ]; then
  printf 'ok shared agent directory\n'
else
  printf 'warn shared agent directory missing; run Home Manager activation\n' >&2
fi

# A private work overlay may refine the portable base prompt. The optional
# renderer keeps an OSS bootstrap current without making OSS depend on work.
if [ -x "$HOME/.local/bin/render-work-agent-prompts" ]; then
  "$HOME/.local/bin/render-work-agent-prompts"
fi
