#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
encrypted_secret="$repo_root/env/.env-secrets.gpg"
destination="$HOME/.env-secrets"

is_legacy_repository_symlink() {
  local linked_path="$1"
  local link_directory
  local resolved_path

  if [[ "$linked_path" == /* ]]; then
    link_directory="$(dirname "$linked_path")"
  else
    link_directory="$(dirname "$destination")/$(dirname "$linked_path")"
  fi

  if ! link_directory="$(cd "$link_directory" && pwd -P)"; then
    return 1
  fi

  resolved_path="$link_directory/$(basename "$linked_path")"
  [[ "$resolved_path" == "$repo_root/env/.env-secrets" ]]
}

if [[ ! -f "$encrypted_secret" ]]; then
  printf 'Encrypted file env/.env-secrets.gpg not found.\n'
  exit 0
fi

umask 077
temporary="$(mktemp "${destination}.tmp.XXXXXX")"
trap 'rm -f "$temporary"' EXIT

printf 'Decrypting env/.env-secrets.gpg...\n'
gpg --decrypt "$encrypted_secret" >"$temporary"
chmod 600 "$temporary"

if [[ -L "$destination" ]]; then
  linked_path="$(readlink "$destination")"
  if is_legacy_repository_symlink "$linked_path"; then
    rm -f "$destination"
  else
    printf 'secrets: refusing to replace unexpected symlink: %s\n' "$destination" >&2
    exit 1
  fi
fi

mv -f "$temporary" "$destination"
trap - EXIT
