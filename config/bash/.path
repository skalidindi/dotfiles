path_append() {
  local directory="$1"

  [ -d "$directory" ] || return 0
  case ":$PATH:" in
    *":$directory:"*) ;;
    *) PATH="${PATH:+$PATH:}$directory" ;;
  esac
}

path_prepend() {
  local directory="$1"
  local entry
  local previous_ifs="$IFS"
  local updated_path=""

  [ -d "$directory" ] || return 0
  IFS=:
  for entry in $PATH; do
    [ "$entry" = "$directory" ] && continue
    updated_path="${updated_path:+$updated_path:}$entry"
  done
  IFS="$previous_ifs"
  PATH="$directory${updated_path:+:$updated_path}"
}

# Keep Home Manager authoritative even when a parent process inherited a
# legacy tool directory ahead of the user profile.
path_prepend "$HOME/.nix-profile/bin"

# Append retained machine-local and user-owned executable directories.
path_append "$HOME/bin"
path_append /opt/homebrew/bin
path_append /opt/homebrew/sbin
path_append /usr/local/bin
path_append /usr/local/sbin
path_append "$HOME/Library/Application Support/Coursier/bin"
path_append "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
path_append "$HOME/istio-1.25.2/bin"
path_append "$HOME/go/bin"
path_append "$HOME/.cargo/bin"
path_append "$HOME/.npm-global/bin"

export VOLTA_HOME="$HOME/.volta"
path_prepend "$VOLTA_HOME/bin"
path_append "$HOME/.local/bin"
path_append "$HOME/.nub/bin"
path_append "$HOME/.antigravity/antigravity/bin"
path_append "$HOME/xp-env/bin"
path_append "$HOME/.lmstudio/bin"

export PATH
unset -f path_append path_prepend
