#!/usr/bin/env bash

# Keep agent identity scoped to the process that is launched.
claude() {
  HERDR_AGENT=claude command claude "$@"
}

codex() {
  HERDR_AGENT=codex newt --app-type=coding-assistant -- codex "$@"
}

pi() {
  HERDR_AGENT=pi command pi "$@"
}

path-list() {
  printf '%s\n' "$PATH" | tr ':' '\n'
}

c() {
  command pbcopy
}

v() {
  local file
  file="$(command fd --type f --hidden --exclude .git | command fzf --preview 'bat --style numbers,changes --color=always {}')"
  if [[ -n "$file" ]]; then
    command nvim "$file"
  fi
}

reset_vpn() {
  local pid
  pid="$(command pgrep -f dsAccessService | command head -n 1)"
  if [[ -n "$pid" ]]; then
    command sudo kill -SEGV "$pid"
  fi
  command sudo route delete pcs.flxvpn.net
}

codex_pr_netflix() {
  local state="$HOME/.codex/.codex-global-state.json"
  local stamp backup updated attempts still_running

  if [[ ! -f "$state" ]]; then
    printf 'Codex state file not found: %s\n' "$state" >&2
    return 1
  fi

  if [[ "$(command osascript -e 'application id "com.openai.codex" is running')" == true ]]; then
    if ! command osascript -e 'tell application id "com.openai.codex" to quit'; then
      printf '%s\n' 'Failed to quit Codex' >&2
      return 1
    fi

    attempts=0
    while (( attempts < 50 )); do
      still_running="$(command osascript -e 'application id "com.openai.codex" is running')"
      [[ "$still_running" != true ]] && break
      command sleep 0.1
      ((attempts++))
    done

    still_running="$(command osascript -e 'application id "com.openai.codex" is running')"
    if [[ "$still_running" == true ]]; then
      printf '%s\n' 'Codex did not quit within 5 seconds' >&2
      return 1
    fi
  fi

  stamp="$(command date +%Y%m%d-%H%M%S)"
  backup="${state}.bak-${stamp}"
  if ! updated="$(command jq '."electron-persisted-atom-state"."pull-request-last-account" = {"hostId":"local","hostname":"github.netflix.net","login":"skalidindi"}' "$state")"; then
    printf '%s\n' 'Failed to update Codex state' >&2
    return 1
  fi

  command cp "$state" "$backup" || return 1
  printf '%s\n' "$updated" > "${state}.new" || return 1
  command mv -f "${state}.new" "$state" || return 1

  command open -a ChatGPT
  printf 'Configured Codex Pull requests for github.netflix.net and reopened Codex. Backup: %s\n' "$backup"
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
		# the .tar file is smaller than 50 MB and Zopfli is available; use it
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

online() {
  ping -c 1 1.1.1.1 >/dev/null 2>&1 && printf '✔' || printf '✘'
}

function killport() {
  lsof -t -i tcp:$1 | xargs kill -9
}

# Yazi (https://yazi-rs.github.io/docs/quick-start/)
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}
