#!/usr/bin/env bash

# Exa
alias ls="command eza --icons"
alias la="command eza --icons -a"
alias ll="ls --long --header --git"
alias lt="ls --tree --level=4 -I=.git --git-ignore"
alias oo="open"
alias doc="cd ~/Documents"
alias desk="cd ~/Desktop"
alias cpr="codex_pr_netflix"
alias codex-pr-netflix="codex_pr_netflix"

# Enable aliases to be sudo’ed
alias sudo="sudo "

# Get week number
alias week="date +%V"

# Force nvim
alias vim="nvim"
alias vi="nvim"

alias gcb="git branch --sort=-committerdate | fzf --header Checkout | xargs git checkout"

alias get_ip="ipconfig getifaddr en0 | pbcopy"

alias cat="bat --style=plain"

# Git
alias g="git"
alias ga="git add"
alias gca="git commit -a"
alias gb="git branch"
alias gc="git commit"
alias gcl="git clone"
alias gcf="git commit --fixup"
alias gd="git diff"
alias gl="git log --graph --pretty='%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'"
alias gp="git push"
alias gpf="git push --force-with-lease --force-if-includes"
alias grf="git reflog"
alias gst="git status"
alias gsw="git switch"
alias gu="git pull"

#LazyGit
alias lg="lazygit"
