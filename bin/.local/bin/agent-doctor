#!/usr/bin/env bash
set -euo pipefail

status_path() {
  local path="$1"
  local label="$2"

  if [[ -e "$path" || -L "$path" ]]; then
    printf 'ok    %-28s %s\n' "$label" "$path"
  else
    printf 'miss  %-28s %s\n' "$label" "$path"
  fi
}

status_command() {
  local command="$1"

  if command -v "$command" >/dev/null 2>&1; then
    printf 'ok    %-28s %s\n' "$command" "$(command -v "$command")"
  else
    printf 'miss  %-28s not on PATH\n' "$command"
  fi
}

printf 'agent-doctor\n============\n\n'
printf 'Portable assets\n---------------\n'
for entry in \
  "$HOME/.agents/README.md:shared agents readme" \
  "$HOME/.agents/prompts/base.md:base prompt" \
  "$HOME/.agents/profiles/core.skills:core skill profile" \
  "$HOME/.claude/CLAUDE.md:claude prompt" \
  "$HOME/.codex/AGENTS.md:codex prompt"; do
  path="${entry%%:*}"
  label="${entry#*:}"
  status_path "$path" "$label"
done

printf '\nCommands\n--------\n'
for command in agent-skill-profile codex claude pi; do
  status_command "$command"
done

printf '\nRuntime boundaries\n------------------\n'
for path in "$HOME/.claude" "$HOME/.codex" "$HOME/.pi/agent"; do
  if [[ -d "$path" && ! -L "$path" ]]; then
    printf 'ok    %-28s real local directory\n' "${path#$HOME/}"
  else
    printf 'warn  %-28s should be a real local directory\n' "${path#$HOME/}"
  fi
done

printf '\nConfiguration\n-------------\n'
if command -v agent-config >/dev/null 2>&1; then
  agent-config status || true
else
  printf 'info  agent-config is available after the work dotfiles install\n'
fi

printf '\nNext\n----\n'
printf 'Run bootstrap for portable assets and the work installer for Netflix/private configuration.\n'
